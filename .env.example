# Prisma connection string. SQLite file for local dev; see README for the Postgres swap.
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs. Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-32-byte-string"

# development | test | production
NODE_ENV="development"

# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL="info"
